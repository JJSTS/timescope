{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "java -Xms256m -Xmx700m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -jar -Dspring.profiles.active=prod target/*.jar",
    "restartPolicyType": "ON_FAILURE"
  }
}
